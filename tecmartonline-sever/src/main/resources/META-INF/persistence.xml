<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="TechMartOnlinePU" transaction-type="JTA">
        <jta-data-source>jdbc/techmartonline</jta-data-source>
        <properties>
            <property name="eclipselink.logging.level" value="WARNING"/>
            <property name="eclipselink.logging.parameters" value="false"/>
            <property name="eclipselink.logging.sql" value="false"/>
            <!-- Performance Tuning Properties -->
            <property name="eclipselink.cache.shared.default" value="true"/>
            <property name="eclipselink.query-results-cache" value="true"/>
            <property name="eclipselink.jdbc.batch-writing" value="JDBC"/>
            <property name="eclipselink.jdbc.batch-writing.size" value="50"/>
        </properties>
    </persistence-unit>
</persistence>
